<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lobby_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFDEE9"
    tools:context=".LobbyActivity">

    <!-- Animasyonlu arkaplan sembolleri -->
    <FrameLayout
        android:id="@+id/animatedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Üst Bar: Jeton ve Rekor -->
    <LinearLayout
        android:id="@+id/lobbyTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_vertical"
        android:background="#22000000">

        <!-- Jeton Göstergesi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🪙 "
                android:textSize="24sp" />
            <TextView
                android:id="@+id/coinsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>
        </LinearLayout>

        <!-- Rekor Göstergesi -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:gravity="end|center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 "
                android:textSize="24sp" />
            <TextView
                android:id="@+id/highScoreTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:shadowColor="#000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Oyun Logosu -->
    <TextView
        android:id="@+id/gameTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EŞLEŞTİRME"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FF4081"
        android:shadowColor="#FFFFFF"
        android:shadowDx="4"
        android:shadowDy="4"
        android:shadowRadius="8"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="30dp" />

    <!-- Başla Butonu (Klasik Mod) -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="200dp"
        android:layout_height="70dp"
        android:text="OYNA"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#FF4081"
        app:cornerRadius="35dp"
        app:layout_constraintTop_toBottomOf="@id/gameTitle"
        app:layout_constraintBottom_toTopOf="@id/survivalButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Hayatta Kalma (Survival) Modu -->
    <Button
        android:id="@+id/survivalButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="SONSUZ MOD"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#9C27B0"
        app:cornerRadius="30dp"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        app:layout_constraintBottom_toTopOf="@id/questsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp" />

    <!-- Günlük Görevler -->
    <Button
        android:id="@+id/questsButton"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="GÜNLÜK GÖREVLER"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#FF9800"
        app:cornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/survivalButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
